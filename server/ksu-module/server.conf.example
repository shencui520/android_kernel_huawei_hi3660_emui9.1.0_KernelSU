# Persistent data lives outside the module so upgrades do not remove it.
STATE_DIR=/data/adb/hi3660-server
SERVER_MOUNT=/data/local/linux-server

# init-storage creates this image only when explicitly requested.
STORAGE_SIZE_MB=8192
PREALLOCATE_STORAGE=1
FSCK_ON_MOUNT=1
AUTO_MOUNT_STORAGE=1

AUTO_START_DOCKER=1
AUTO_RESTART_DOCKER=1
AUTO_START_LINUX=0
AUTO_RESTART_LINUX=0

# auto searches Android, KernelSU module and Termux command locations.
DOCKERD_BIN=auto
DOCKER_BIN=auto
RUNC_BIN=auto
UNSHARE_BIN=auto
NSENTER_BIN=auto

LINUX_HOSTNAME=hi3660-linux
MONITOR_INTERVAL=30
